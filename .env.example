# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (server only) ---
# Project Settings -> API. The service role key bypasses row-level security,
# so it must only ever be used on the server (it is never sent to browsers).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Maps Platform ---
# Server key: Places API (New) + Routes API. Used for address lookup, venue
# search, travel times and directions. Never exposed to the browser.
GOOGLE_MAPS_SERVER_KEY=

# Browser key: Maps JavaScript API only. Restrict it to your domain(s) with
# HTTP referrer restrictions in Google Cloud Console. (It's read by the server
# at request time and handed to the map, so no rebuild is needed to change it.)
# The older name NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY also works locally.
GOOGLE_MAPS_BROWSER_KEY=

# Map ID (Google Cloud -> Map Management, type JavaScript). Needed for the
# custom map pins. DEMO_MAP_ID works to get started.
GOOGLE_MAP_ID=DEMO_MAP_ID
